   "obligatoire": false,
   "multiple": true
  },
  {
   "code": "inclure_sortants",
   "libelle": "Inclure les sorties (payés dans la période de comparaison seulement)",
   "type": "BOOLEEN",
   "obligatoire": false,
   "defaut": "VRAI"
  },
  {
   "code": "seuil",
   "libelle": "Seuil d'alerte (variation du net, en %)",
   "type": "NOMBRE",
   "obligatoire": false,
   "defaut": "10"
  },
  {
   "code": "affichage",
   "libelle": "Salariés affichés",
   "type": "LISTE",
   "obligatoire": false,
   "defaut": "\"Tous\"",
   "valeurs": [
    "Tous",
    "Écarts et entrées seulement"
   ]
  }
 ],
 "jeux": [
  {
   "code": "b",
   "source": "BULLETIN",
   "role": "PRINCIPAL",
   "filtres": [
    "periode_id = @periode.id",
    "OU(@affichage <> \"Écarts et entrées seulement\", precedent.existe = 0, sortant = 1, ABS(pct_net) >= @seuil)"
   ],
   "calculs": [
    {
     "code": "ecart_brut",
     "expression": "total_brut - SIVIDE(precedent.total_brut, 0)"
    },
    {
     "code": "ecart_net",
     "expression": "net_a_payer - SIVIDE(precedent.net_a_payer, 0)"
    },
    {
     "code": "pct_net",
     "expression": "SI(SIVIDE(precedent.net_a_payer, 0) = 0, 0, (net_a_payer - precedent.net_a_payer) / precedent.net_a_payer * 100)"
    }
   ],
   "tri": [
    {
     "champ": "identite.nom"
    },
    {
     "champ": "identite.prenom"
    }
   ]
  }
 ],
 "usages": {
  "confidentialite": 3
 },
 "page": {
