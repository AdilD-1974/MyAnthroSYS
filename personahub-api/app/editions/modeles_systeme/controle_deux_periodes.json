   "multiple": true
  },
  {
   "code": "inclure_sortants",
   "libelle": "Inclure les sorties (payés dans la période de comparaison seulement)",
   "type": "BOOLEEN",
   "obligatoire": false,
   "defaut": "VRAI"
  },
  {
   "code": "seuil",
   "libelle": "Seuil d'alerte (variation du net, en %)",
   "type": "NOMBRE",
   "obligatoire": false,
   "defaut": "10"
  },
  {
   "code": "affichage",
   "libelle": "Salariés affichés",
   "type": "LISTE",
   "obligatoire": false,
   "defaut": "\"Tous les salariés\"",
   "valeurs": [
    "Tous les salariés",
    "Mouvements et écarts seulement"
   ]
  }
 ],
 "jeux": [
  {
   "code": "b",
   "source": "BULLETIN",
   "role": "PRINCIPAL",
   "filtres": [
    "periode_id = @periode.id"
   ],
   "calculs": [
    {
     "code": "mvt_rang",
     "expression": "SI(mouvement = \"ENTREE\", 1, SI(mouvement = \"SORTIE\", 2, 3))"
    },
    {
     "code": "mvt_lib",
     "expression": "SI(mouvement = \"ENTREE\", \"Entrées — pas de bulletin dans la période de référence\", SI(mouvement = \"SORTIE\", \"Sorties — bulletin dans la période de référence seulement\", \"Salariés payés dans les deux périodes\"))"
    },
    {
     "code": "ecart_brut",
     "expression": "total_brut - SIVIDE(precedent.total_brut, 0)"
    },
    {
     "code": "ecart_net",
     "expression": "net_a_payer - SIVIDE(precedent.net_a_payer, 0)"
    },
    {
     "code": "ecart_cout",
     "expression": "SIVIDE(cout_employeur, 0) - SIVIDE(precedent.cout_employeur, 0)"
    },
    {
     "code": "pct_net",
     "expression": "SI(SIVIDE(precedent.net_a_payer, 0) = 0, 0, (net_a_payer - precedent.net_a_payer) / precedent.net_a_payer * 100)"
    }
   ],
   "tri": [
    {
     "champ": "mvt_rang"
    },
    {
     "champ": "identite.nom"
    },
    {
     "champ": "identite.prenom"
    }
   ],
   "groupes": [
    "mvt_lib"
   ]
  }
 ],
