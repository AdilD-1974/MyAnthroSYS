     "x": 0.0,
     "y": 2.0,
     "l": 180.0,
     "h": 40.0,
     "style": {
      "taille": 10.5
     },
     "extensible": true,
     "type": "TEXTE_RICHE",
     "contenu": "Nous soussignés, {societe.raison_sociale}{SI(ESTVIDE(societe.forme_juridique), \"\", \", \" + societe.forme_juridique)}, dont le siège est situé {SIVIDE(societe.adresse, \"\")}{SI(ESTVIDE(societe.ville), \"\", \" à \" + societe.ville)}, immatriculée à la CNSS sous le n° {SIVIDE(societe.numero_cnss, \"—\")}, certifions que :\n\n{SIVIDE(identite.civilite, \"\") + \" \" + MAJUSCULE(identite.nom) + \" \" + identite.prenom}, titulaire de la CIN n° {SIVIDE(identite.cin, \"—\")}, immatriculé(e) à la CNSS sous le n° {SIVIDE(identite.num_cnss, \"—\")}, a été employé(e) dans notre société du {SI(ESTVIDE(contrat.date_embauche), \"……………\", FORMAT(contrat.date_embauche, \"DATE_LONGUE\"))} au {FORMAT(depart.date_depart, \"DATE_LONGUE\")}, en qualité de {SIVIDE(affectation.emploi_libelle, SIVIDE(qualification.fonction_libelle, \"salarié(e)\"))}{SI(ESTVIDE(qualification.categorie_professionnelle_libelle), \"\", \" (catégorie \" + qualification.categorie_professionnelle_libelle + \")\")}.\n\n{SI(@libre, \"L'intéressé(e) nous quitte libre de tout engagement.\", \"\")}\n\nEn foi de quoi, le présent certificat lui est délivré pour servir et valoir ce que de droit."
    }
   ]
