 "variables": [
  {
   "code": "plafond",
   "libelle": "Plafond CNSS (prestations sociales)",
   "type": "MONTANT",
   "valeur": "SIVIDE(#CNSS_PLAFOND, 6000)"
  },
  {
   "code": "tx_ps_sal",
   "libelle": "Taux CNSS salarial (%)",
   "type": "NOMBRE",
   "valeur": "4.48"
  },
  {
   "code": "tx_ps_pat",
   "libelle": "Taux CNSS patronal (%)",
   "type": "NOMBRE",
   "valeur": "8.98"
  },
  {
   "code": "tx_af",
   "libelle": "Allocations familiales, patronal (%)",
   "type": "NOMBRE",
   "valeur": "6.40"
  },
  {
   "code": "tx_amo_sal",
   "libelle": "AMO salariale (%)",
   "type": "NOMBRE",
   "valeur": "2.26"
  },
  {
   "code": "tx_amo_pat",
   "libelle": "AMO patronale, participation comprise (%)",
   "type": "NOMBRE",
   "valeur": "4.11"
  },
  {
   "code": "tx_tfp",
   "libelle": "Taxe de formation professionnelle (%)",
   "type": "NOMBRE",
   "valeur": "1.60"
  },
  {
   "code": "base_ps",
   "libelle": "Base plafonnée",
   "type": "MONTANT",
   "valeur": "MIN(total_brut, var.plafond)"
  },
  {
   "code": "ps_sal",
   "libelle": "CNSS salariale",
   "type": "MONTANT",
   "valeur": "ARRONDI(var.base_ps * var.tx_ps_sal / 100, 2)"
  },
  {
   "code": "ps_pat",
   "libelle": "CNSS patronale",
   "type": "MONTANT",
   "valeur": "ARRONDI(var.base_ps * var.tx_ps_pat / 100, 2)"
  },
  {
   "code": "af",
   "libelle": "Allocations familiales",
   "type": "MONTANT",
   "valeur": "ARRONDI(total_brut * var.tx_af / 100, 2)"
  },
  {
   "code": "amo_sal",
   "libelle": "AMO salariale",
   "type": "MONTANT",
   "valeur": "ARRONDI(total_brut * var.tx_amo_sal / 100, 2)"
  },
  {
   "code": "amo_pat",
   "libelle": "AMO patronale",
   "type": "MONTANT",
   "valeur": "ARRONDI(total_brut * var.tx_amo_pat / 100, 2)"
  },
  {
   "code": "tfp",
   "libelle": "TFP",
   "type": "MONTANT",
   "valeur": "ARRONDI(total_brut * var.tx_tfp / 100, 2)"
  },
  {
   "code": "total",
   "libelle": "Total des cotisations",
   "type": "MONTANT",
   "valeur": "var.ps_sal + var.ps_pat + var.af + var.amo_sal + var.amo_pat + var.tfp"
  }
 ],
 "usages": {
  "confidentialite": 3
 },
