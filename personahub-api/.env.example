# ── Base de données PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://personahub:motdepasse@localhost:5432/personahub_hr

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
SECRET_KEY=changez-moi-avec-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=PersonaHub HR
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://votre-domaine.ma

# ── Email (optionnel — pour reset mot de passe) ───────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@votre-domaine.ma
